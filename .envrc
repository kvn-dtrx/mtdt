# Wire package roots + helper PATH while cwd is this repo (direnv).
# Production / cron: make install → ~/.local/bin stubs set the same vars.
#
# Requires: eval "$(direnv hook zsh)" (or bash/fish) in your shell rc.
# Once per clone: direnv allow
#
# Flat libexec helpers are invoked by basename on PATH (extension included
# when the file has one, e.g. find-filepaths.sh).

watch_file src/wire/lib
watch_file src/wire/libexec

_pkg="$(basename "${PWD}")"
_local="${MY_LOCAL_HOME:-${HOME}/.local}"
_installed_libexec="${_local}/libexec/${_pkg}"
_installed_lib="${_local}/lib/${_pkg}"
_src_libexec="${PWD}/src/wire/libexec"
_src_lib="${PWD}/src/wire/lib"

export WIRE_ROOT="${PWD}"
if [ -d "${_src_lib}" ]; then
	export WIRE_LIB="${_src_lib}"
elif [ -d "${_installed_lib}" ]; then
	export WIRE_LIB="${_installed_lib}"
fi

# Prefer in-tree helpers while developing (edits apply immediately).
if [ -d "${_src_libexec}" ]; then
	export WIRE_LIBEXEC="${_src_libexec}"
	PATH_add "${_src_libexec}"
elif [ -d "${_installed_libexec}" ]; then
	export WIRE_LIBEXEC="${_installed_libexec}"
	PATH_add "${_installed_libexec}"
fi

unset _pkg _local _installed_libexec _installed_lib _src_libexec _src_lib
