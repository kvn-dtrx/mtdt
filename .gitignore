# ---
# title: Gitignore for Mtdt
# ---

# ---

# dia:begin gitignore/base.ignore

# --- Base ---

# macOS
.AppleDouble
.DS_Store
.LSOverride
.Spotlight-V100
.Trashes
._*
* [0-9]
* [0-9].*
* copy
* copy.*
*.nosync/
Icon[[]]

# Linux
.nfs*
*~

# Windows
$RECYCLE.BIN/
Desktop.ini
ehthumbs.db
Thumbs.db

# Logs, temporary files, regenerable cache
*.bak
*.bak[0-9]*
*.bkp
*.cache
*.log
*.old
*.swn
*.swns
*.swo
*.swp
*.tmp
*.tmp.*
*_tmp.*
build/
cache/
.cache/
log/
.log/
logs/
.logs/
tmp/
.tmp/

# Local mountpoints
mnt/
mount/
mounts/

# Scripting-language artefacts
*.py[cod]
*.rbc
.ruby-lsp/
__pycache__/

# Local environment variables
.env
.env.*
env/
env.bak/

# Local configuration overrides
*.local
*.local.*

# dia:end

# Keep tracked defaults (base ignores .env.*)
!.env.default

# dia:begin gitignore/python.ignore

# --- Python ---

# Packages and bytecode
*.egg-info/
*.pyc
*.pyi
__pycache__/

# Local configuration
/.python-version
local_settings.py

# Linter artefacts
.ruff_cache/

# Type-checker artefacts
.dmypy.json
.mypy_cache/
dmypy.json

# Virtual environments
.venv/
env/
env.bak/
venv/
venv.bak/

# dia:end
